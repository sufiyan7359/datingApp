DATABASE_URL="postgresql://user@localhost:5432/datingapp?schema=public"

PORT=8000
NODE_ENV=development

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Generate a pair with `npx web-push generate-vapid-keys` - VAPID_PUBLIC_KEY is
# also served to the frontend from GET /notifications/vapid-public-key.
VAPID_PUBLIC_KEY=replace-with-a-generated-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-a-generated-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# Used to build links in emails (password reset, etc). Point at the deployed
# frontend URL in production.
FRONTEND_URL=http://localhost:4200

# If unset, EmailService logs emails instead of sending them - no SMTP
# credentials are required for local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@datingapp.example
