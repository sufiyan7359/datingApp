// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  isActive      Boolean  @default(true)
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // TOTP (authenticator app) 2FA. Secret is only meaningful once enabled;
  // while the user is mid-setup (scanned QR, not yet confirmed) it is held in
  // a short-lived JWT instead - see auth.service.ts.
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  refreshTokens      RefreshToken[]
  profile            Profile?
  swipesGiven        Swipe[]              @relation("SwipesGiven")
  swipesReceived     Swipe[]              @relation("SwipesReceived")
  matchesAsA         Match[]              @relation("MatchesAsA")
  matchesAsB         Match[]              @relation("MatchesAsB")
  messages           Message[]
  reactions          MessageReaction[]
  callsMade          Call[]               @relation("CallsMade")
  callsReceived      Call[]               @relation("CallsReceived")
  subscriptions      Subscription[]
  blocksMade         Block[]              @relation("BlocksMade")
  blocksReceived     Block[]              @relation("BlocksReceived")
  reportsMade        Report[]             @relation("ReportsMade")
  reportsReceived    Report[]             @relation("ReportsReceived")
  mutedConversations MutedConversation[]
  pushSubscriptions  PushSubscription[]

  @@map("users")
}

enum VerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
}

enum RelationshipGoal {
  LONG_TERM
  SHORT_TERM
  CASUAL
  FRIENDSHIP
  NOT_SURE
}

enum LifestyleChoice {
  NEVER
  SOMETIMES
  REGULARLY
}

model Profile {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  gender        Gender?
  interestedIn  Gender[]
  dateOfBirth   DateTime?
  heightCm      Int?
  religion      String?
  languages     String[]
  profession    String?
  education     String?
  bio           String?
  city          String?
  country       String?
  latitude      Float?
  longitude     Float?

  smoking          LifestyleChoice?
  drinking         LifestyleChoice?
  workout          LifestyleChoice?
  relationshipGoal RelationshipGoal?
  hasKids          Boolean?
  wantsKids        Boolean?
  hasPets          Boolean?
  interests        String[]

  onboardingCompleted Boolean   @default(false)
  boostedUntil        DateTime?

  // Premium-only (Gold/Platinum): browse discovery without appearing in it yourself.
  isIncognito Boolean @default(false)
  // Premium-only: browse another location instead of your real one. Presence of
  // both coordinates means passport mode is active; clear both to go back to `latitude`/`longitude`.
  passportLatitude  Float?
  passportLongitude Float?
  passportCity      String?
  passportCountry   String?

  // Privacy settings (free, unlike incognito/passport above).
  hideAge          Boolean @default(false)
  hideDistance     Boolean @default(false)
  hideOnlineStatus Boolean @default(false)

  // Identity verification: user submits a selfie, an admin compares it
  // against the profile photos and approves/rejects - see verification.service.ts.
  verificationStatus      VerificationStatus @default(NONE)
  verificationSelfieUrl   String?
  verificationSubmittedAt DateTime?
  verificationReviewedAt  DateTime?
  verificationNote        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos          Photo[]
  boostActivations BoostActivation[]

  @@index([verificationStatus])
  @@map("profiles")
}

model BoostActivation {
  id         String   @id @default(uuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  activatedAt DateTime @default(now())

  @@index([profileId, activatedAt])
  @@map("boost_activations")
}

model Photo {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)
  isPrimary Boolean @default(false)

  // When true, `blurredUrl` (a server-generated blurred variant, not just a
  // CSS filter) is served instead of `url` to anyone who hasn't matched the
  // owner yet - see profiles.service.ts / photo-response.dto.ts.
  isBlurred   Boolean @default(false)
  blurredUrl  String?

  createdAt DateTime @default(now())

  @@index([profileId])
  @@map("photos")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum SwipeAction {
  LIKE
  PASS
  SUPER_LIKE
}

model Swipe {
  id       String      @id @default(uuid())
  swiperId String
  swiper   User        @relation("SwipesGiven", fields: [swiperId], references: [id], onDelete: Cascade)
  targetId String
  target   User        @relation("SwipesReceived", fields: [targetId], references: [id], onDelete: Cascade)
  action   SwipeAction

  createdAt DateTime  @default(now())
  undoneAt  DateTime?

  @@unique([swiperId, targetId])
  @@index([targetId])
  @@index([swiperId, createdAt])
  @@map("swipes")
}

model Match {
  id      String @id @default(uuid())
  userAId String
  userA   User   @relation("MatchesAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId String
  userB   User   @relation("MatchesAsB", fields: [userBId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("matches")

  conversation Conversation?
}

model Conversation {
  id      String @id @default(uuid())
  matchId String @unique
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  messages Message[]
  calls    Call[]
  mutedBy  MutedConversation[]

  @@map("conversations")
}

enum CallType {
  VOICE
  VIDEO
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
}

model Call {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  callerId       String
  caller         User         @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  calleeId       String
  callee         User         @relation("CallsReceived", fields: [calleeId], references: [id], onDelete: Cascade)

  type   CallType
  status CallStatus @default(RINGING)

  startedAt   DateTime  @default(now())
  connectedAt DateTime?
  endedAt     DateTime?

  @@index([conversationId])
  @@index([callerId])
  @@index([calleeId])
  @@map("calls")
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  type      MessageType @default(TEXT)
  content   String?
  mediaUrl  String?

  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  isPinned    Boolean   @default(false)
  deliveredAt DateTime?
  readAt      DateTime?
  deletedAt   DateTime?

  createdAt DateTime @default(now())

  reactions MessageReaction[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum SubscriptionTier {
  FREE
  GOLD
  PLATINUM
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

/// Payment collection is not wired up yet (no Stripe/Razorpay credentials) -
/// see subscriptions.service.ts. Rows here represent an entitlement, not proof of payment.
model Subscription {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier         SubscriptionTier
  billingCycle BillingCycle
  status       SubscriptionStatus @default(ACTIVE)
  priceCents   Int
  autoRenew    Boolean            @default(true)

  startedAt  DateTime  @default(now())
  expiresAt  DateTime
  canceledAt DateTime?

  promoCodeId String?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("subscriptions")
}

model PromoCode {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Int
  maxRedemptions  Int?
  redemptionCount Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)

  createdAt DateTime @default(now())

  subscriptions Subscription[]

  @@map("promo_codes")
}

model MessageReaction {
  id        String @id @default(uuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String

  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

enum ReportReason {
  INAPPROPRIATE_PHOTOS
  HARASSMENT
  FAKE_PROFILE
  SPAM
  UNDERAGE
  OFFLINE_BEHAVIOR
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  ACTION_TAKEN
  DISMISSED
}

/// No moderation UI exists yet to review these (deferred to the admin panel
/// phase) - this just records them for now.
model Report {
  id          String       @id @default(uuid())
  reporterId  String
  reporter    User         @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId  String
  reported    User         @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)
  reason      ReportReason
  description String?
  status      ReportStatus @default(PENDING)
  adminNote   String?
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([reportedId])
  @@index([status])
  @@map("reports")
}

model MutedConversation {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, conversationId])
  @@map("muted_conversations")
}

/// One row per subscribed browser/device (a user can have several). Pruned
/// automatically when the push service reports it as gone - see
/// notifications.service.ts.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}
